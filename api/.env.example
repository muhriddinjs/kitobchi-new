# Database
DATABASE_URL="postgresql://kitobchi:kitobchi@localhost:5432/kitobchi"

# Redis
REDIS_URL="redis://localhost:6379"

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="kitobchi_dev_master_key"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="kitobchi-listings"
S3_ACCESS_KEY="kitobchi"
S3_SECRET_KEY="kitobchi_dev_secret"
S3_PUBLIC_URL="http://localhost:9000/kitobchi-listings"

# JWT
JWT_ACCESS_SECRET="change_me_dev_access_secret"
JWT_REFRESH_SECRET="change_me_dev_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# SMS OTP — Eskiz.uz
ESKIZ_BASE_URL="https://notify.eskiz.uz/api"
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"
OTP_TTL_SECONDS="120"
OTP_RESEND_COOLDOWN_SECONDS="60"

# App
PORT=3001
NODE_ENV=development

# Comma-separated list of allowed frontend origins (no trailing slashes).
# In production, set this to the real deployed web app domain(s).
CORS_ORIGINS="http://localhost:3000"
